[Unit]
Description=pearOS Nexus Smart Remote 3.0
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/aryan/.gemini/antigravity/scratch/smart-remote
Environment="PYTHONPATH=/home/aryan/.gemini/antigravity/scratch/smart-remote"
ExecStart=/usr/bin/systemd-inhibit --what=handle-lid-switch:sleep:idle --why="pearOS Smart Remote 24/7 background operation" /home/aryan/.gemini/antigravity/scratch/smart-remote/.venv/bin/python3 -m uvicorn backend.app.main:app --host 0.0.0.0 --port 7070
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
